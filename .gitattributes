# Normalise line endings so the repo behaves the same on Windows, macOS and CI.
* text=auto eol=lf

# These must keep LF even on Windows: ffmpeg-core.js is executed by the worker
# and the headers file is parsed verbatim by Netlify-style hosts.
*.js text eol=lf
*.mjs text eol=lf
public/ffmpeg/ffmpeg-core.js text eol=lf
public/_headers text eol=lf

# Binary assets
*.wasm binary
*.svg text eol=lf
*.jpg binary
*.png binary
*.ico binary